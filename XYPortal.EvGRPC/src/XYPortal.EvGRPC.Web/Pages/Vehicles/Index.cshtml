@page
@using XYPortal.EvGRPC.Localization
@using XYPortal.EvGRPC.Web.Pages.Vehicles
@model XYPortal.EvGRPC.Web.Pages.Vehicles.IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<EvGRPCResource> L
@inject XYPortal.EvGRPC.Vehicles.IVehicleAppService VehicleApp

@{ Layout = "_Layout"; }

<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <abp-card-title>@L["Vehicle"]</abp-card-title>
            </abp-column>
            <abp-column size-md="_6" class="text-end">
                <abp-button id="NewVehicleButton"
                            text="@L["NewVehicle"].Value"
                            icon="plus"
                            button-type="Primary" />
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table striped-rows="true" id="VehiclesTable">
            <thead>
                <tr>
                    <th>@L["Actions"]</th>
                    <th>@L["Brand"]</th>
                    <th>@L["LicensePlate"]</th>
                    <th>@L["CalibratedRangeKm"]</th>
                    <th>@L["BatteryCapacityKwh"]</th>
                    <th>@L["CurrentBattery"]</th>
                    <th>@L["PurchaseDate"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.Vehicles)
                {
                    var battery = Model.BatteryByVehicle.TryGetValue(v.Id, out var b) ? b : 0;
                    var hasBattery = battery > 0;
                    <tr>
                        <td>
                            @*
                                Each row gets its own anti-forgery-token-protected form
                                that POSTs to OnPostDeleteAsync. No JS required:
                                users without JS still see the native browser
                                dialog. With JS we layer a confirm() over the
                                native dialog using the data-confirm attribute.
                            *@
                            <form method="post"
                                  asp-page-handler="Delete"
                                  asp-route-id="@v.Id"
                                  data-confirm="@L["ConfirmDelete"].Value"
                                  class="d-inline-block">
                                @Html.AntiForgeryToken()
                                <abp-button button-type="Danger"
                                            button-size="Small"
                                            type="submit"
                                            icon="trash"
                                            text="@L["Delete"].Value" />
                            </form>
                            <a abp-button="Secondary" abp-button-size="Small"
                               asp-page="/Vehicles/EditModal" asp-page-handler="Edit" asp-route-id="@v.Id">
                                <i class="fa fa-edit"></i> @L["Edit"].Value
                            </a>
                        </td>
                        <td>@v.Brand</td>
                        <td>@v.LicensePlate</td>
                        <td>@v.CalibratedRangeKm</td>
                        <td>@v.BatteryCapacityKwh</td>
                        <td>
                            @if (hasBattery)
                            {
                                <span class="badge bg-success">@battery%</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@L["NoData"]</span>
                            }
                        </td>
                        <td>@v.PurchaseDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </abp-table>
    </abp-card-body>
</abp-card>

@*
    Native confirm() — no JS deps. The handler `OnPostDeleteAsync`
    re-renders the list (RedirectToPage) and the user sees an ABP
    alert on failure; on success the row is gone.
*@
<script>
    document.querySelectorAll('form[data-confirm]').forEach(function (form) {
        form.addEventListener('submit', function (ev) {
            if (!window.confirm(form.dataset.confirm)) ev.preventDefault();
        });
    });
</script>
