@page
@using XYPortal.EvGRPC.Localization
@using XYPortal.EvGRPC.Web.Pages.Chargings
@model XYPortal.EvGRPC.Web.Pages.Chargings.IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<EvGRPCResource> L

@{ Layout = "_Layout"; }

<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <abp-card-title>@L["Charging"]</abp-card-title>
            </abp-column>
            <abp-column size-md="_6" class="text-end">
                <abp-button id="NewChargingButton"
                            text="@L["NewCharging"].Value"
                            icon="plus"
                            button-type="Primary" />
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table striped-rows="true" id="ChargingsTable">
            <thead>
                <tr>
                    <th>@L["Actions"]</th>
                    <th>@L["VehicleId"]</th>
                    <th>@L["StartTime"]</th>
                    <th>@L["EndTime"]</th>
                    <th>@L["StartPercent"]</th>
                    <th>@L["EndPercent"]</th>
                    <th>@L["KwhCharged"]</th>
                    <th>@L["Cost"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Chargings)
                {
                    <tr>
                        <td>
                            <a abp-button="Secondary" abp-button-size="Small"
                               asp-page="/Chargings/EditModal" asp-page-handler="Edit" asp-route-id="@c.Id">
                                <i class="fa fa-edit"></i> @L["Edit"].Value
                            </a>
                            <form method="post"
                                  asp-page-handler="Delete"
                                  asp-route-id="@c.Id"
                                  data-confirm="@L["ConfirmDelete"].Value"
                                  class="d-inline-block">
                                @Html.AntiForgeryToken()
                                <abp-button button-type="Danger"
                                            button-size="Small"
                                            type="submit"
                                            icon="trash"
                                            text="@L["Delete"].Value" />
                            </form>
                        </td>
                        <td>@c.VehicleId</td>
                        <td>@c.StartTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@c.EndTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@c.StartPercent%</td>
                        <td>@c.EndPercent%</td>
                        <td>@c.KwhCharged</td>
                        <td>@c.Cost</td>
                    </tr>
                }
            </tbody>
        </abp-table>
    </abp-card-body>
</abp-card>

<script>
    document.querySelectorAll('form[data-confirm]').forEach(function (form) {
        form.addEventListener('submit', function (ev) {
            if (!window.confirm(form.dataset.confirm)) ev.preventDefault();
        });
    });
</script>
