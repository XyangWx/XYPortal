@page
@using XYPortal.EvGRPC.Localization
@using XYPortal.EvGRPC.Web.Pages.Chargings
@model XYPortal.EvGRPC.Web.Pages.Chargings.EditModalModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<EvGRPCResource> L

@{ Layout = null; }

<abp-dynamic-form abp-model="@Model.Charging" id="EditChargingForm">
    <abp-modal id="EditChargingModal" centered="true" size="Large" title="@L["EditCharging"]">
        <abp-form-content />
        <div class="mt-3">
            @* id is the route parameter, not part of the DTO *@
            <input type="hidden" name="id" value="@ViewContext.RouteData.Values["id"]" />
            <input type="hidden" asp-for="@Model.Charging.VehicleId" />
            <abp-input asp-for="@Model.Charging.StartTime" type="datetime-local" />
            <abp-input asp-for="@Model.Charging.EndTime" type="datetime-local" />
            <abp-input asp-for="@Model.Charging.StartPercent" />
            <abp-input asp-for="@Model.Charging.EndPercent" />
            <abp-input asp-for="@Model.Charging.StartMileageKm" />
            <abp-input asp-for="@Model.Charging.EndMileageKm" />
            <abp-input asp-for="@Model.Charging.KwhCharged" />
            <abp-input asp-for="@Model.Charging.Cost" />
            <abp-input asp-for="@Model.Charging.ElectricityUnitPrice" />
            <abp-input asp-for="@Model.Charging.ServiceFee" />
            <abp-select asp-for="@Model.Charging.ChargerType" asp-items="@Model.ChargerTypes" />
            <abp-input asp-for="@Model.Charging.SourceCategoryId" />
            <abp-input asp-for="@Model.Charging.Location" />
            <abp-input asp-for="@Model.Charging.Remark" />
        </div>
    </abp-modal>
    <abp-modal-footer>
        <abp-button button-type="Secondary" text="@L["Cancel"].Value" data-bs-dismiss="modal" />
        <abp-button id="EditChargingSubmit" button-type="Primary" text="@L["Save"].Value" />
    </abp-modal-footer>
</abp-dynamic-form>
