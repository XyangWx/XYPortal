<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>XYPortal.EvGRPC.EvGrpc</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.65.0" />
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Tools" Version="2.66.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Grpc.Core.Api" Version="2.66.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
  </ItemGroup>

  <!--
    The gRPC project owns the proto ↔ Domain mapper layer. It must
    reference Domain (one-way) so mappers can return Domain entities;
    Domain must NEVER reference back. This enforces constraint C-2.
  -->
  <ItemGroup>
    <ProjectReference Include="..\XYPortal.EvGRPC.Domain\XYPortal.EvGRPC.Domain.csproj" />
  </ItemGroup>

  <!--
    Generate C# clients from upstream .proto files. ProtoRoot lets us write
    `import "evgrpc/common.proto"` (as in display.proto) and have protoc
    resolve it relative to /proto.
  -->
  <ItemGroup>
    <Protobuf Include="proto/evgrpc/*.proto"
              ProtoRoot="proto"
              GrpcServices="Client"
              OutputDir="obj\$(Configuration)\$(TargetFramework)\Generated\EvGrpc" />
    <Protobuf Include="proto/google/type/*.proto"
              ProtoRoot="proto"
              GrpcServices="Client"
              OutputDir="obj\$(Configuration)\$(TargetFramework)\Generated\Google\Type" />
  </ItemGroup>

</Project>
