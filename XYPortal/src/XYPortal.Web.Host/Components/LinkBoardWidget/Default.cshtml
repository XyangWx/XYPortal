@using Microsoft.AspNetCore.Mvc.Localization
@using XYPortal.Localization
@model XYPortal.Web.Components.LinkBoardWidget.LinkBoardWidgetViewModel
@inject IHtmlLocalizer<XYPortalResource> L

<div class="card w-100" id="linkBoardWidget" data-page-size="@Model.PageSize">
    <div class="card-header">
        <h5 class="card-title mb-0">
            <i class="fas fa-link me-2"></i>@L["Menu:LinkBoard"]
        </h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Categories.Any())
        {
            <ul class="nav nav-tabs px-3 pt-2" id="linkBoardTabs" role="tablist">
                @for (var i = 0; i < Model.Categories.Count; i++)
                {
                    var category = Model.Categories[i];
                    var tabId = $"lb-tab-{category.Id}";
                    var paneId = $"lb-pane-{category.Id}";
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(i == 0 ? "active" : "")" id="@tabId" data-bs-toggle="tab"
                                data-bs-target="@paneId" type="button" role="tab"
                                data-category-id="@category.Id"
                                aria-controls="@paneId" aria-selected="@(i == 0 ? "true" : "false")">
                            @if (!string.IsNullOrEmpty(category.Icon))
                            {
                                <i class="@category.Icon me-1"></i>
                            }
                            @(category.DisplayName ?? category.Name)
                        </button>
                    </li>
                }
            </ul>
            <div class="tab-content" id="linkBoardTabContent">
                @for (var i = 0; i < Model.Categories.Count; i++)
                {
                    var category = Model.Categories[i];
                    var paneId = $"lb-pane-{category.Id}";
                    var tabId = $"lb-tab-{category.Id}";
                    var totalCount = Model.TotalCountByCategory.GetValueOrDefault(category.Id);
                    var totalPages = (int)Math.Ceiling((double)totalCount / Model.PageSize);
                    <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="@paneId"
                         role="tabpanel" aria-labelledby="@tabId"
                         data-category-id="@category.Id"
                         data-total-count="@totalCount"
                         data-total-pages="@totalPages"
                         data-current-page="1">
                        <div class="lb-info-bar px-3 py-1 text-muted small d-flex justify-content-between align-items-center">
                            <span>共 <strong>@totalCount</strong> 条链接</span>
                            @if (totalPages > 1)
                            {
                                <span>第 <span class="lb-current-page">1</span>/@totalPages 页</span>
                            }
                        </div>
                        <div class="list-group list-group-flush lb-links-container">
                            @if (Model.LinksByCategory.TryGetValue(category.Id, out var links))
                            {
                                @foreach (var link in links)
                                {
                                    <a href="@link.Url" target="_blank" class="list-group-item list-group-item-action link-item">
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(link.Icon))
                                            {
                                                <i class="@link.Icon me-3 text-primary"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-external-link-alt me-3 text-primary"></i>
                                            }
                                            <div class="text-truncate">
                                                <div class="fw-semibold text-truncate">@link.Title</div>
                                                @if (!string.IsNullOrEmpty(link.Description))
                                                {
                                                    <small class="text-muted text-truncate d-block">@link.Description</small>
                                                }
                                            </div>
                                        </div>
                                    </a>
                                }
                            }
                        </div>
                        @if (totalPages > 1)
                        {
                            <div class="lb-pagination px-3 py-2 d-flex justify-content-center gap-1">
                                <button class="btn btn-sm btn-outline-secondary lb-page-first" title="第一页" disabled>
                                    <i class="fas fa-angle-double-left"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary lb-page-prev" title="前一页" disabled>
                                    <i class="fas fa-angle-left"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary lb-page-next" title="后一页">
                                    <i class="fas fa-angle-right"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary lb-page-last" title="最后一页">
                                    <i class="fas fa-angle-double-right"></i>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">
                <i class="fas fa-link fs-1 mb-2 d-block opacity-25"></i>
                <span>@L["LinkBoard:NoPublicLinks"]</span>
            </div>
        }
    </div>
</div>

<style>
    .link-item {
        transition: background-color 0.15s;
        border-left: 0;
        border-right: 0;
        padding: 10px 12px;
    }
    .link-item:hover {
        background-color: #f0f7ff;
    }
    #linkBoardTabs {
        flex-wrap: nowrap;
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: thin;
    }
    #linkBoardTabs::-webkit-scrollbar {
        height: 3px;
    }
    #linkBoardTabs::-webkit-scrollbar-thumb {
        background: #ccc;
        border-radius: 3px;
    }
    #linkBoardTabs .nav-link {
        white-space: nowrap;
        font-size: 0.875rem;
        padding: 0.4rem 0.75rem;
    }
    .lb-info-bar {
        border-bottom: 1px solid #f0f0f0;
    }
    .lb-pagination .btn {
        min-width: 32px;
    }
    .lb-pagination .btn:disabled {
        opacity: 0.4;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        console.log('[LinkBoard] DOMContentLoaded 初始化开始');
        var widget = document.getElementById('linkBoardWidget');
        console.log('[LinkBoard] widget 元素:', widget);
        if (!widget) {
            console.log('[LinkBoard] widget 未找到，初始化中止');
            return;
        }

        var pageSize = parseInt(widget.dataset.pageSize) || 15;
        console.log('[LinkBoard] pageSize:', pageSize);

        // Listen for pagination button clicks
        widget.addEventListener('click', function (e) {
            console.log('[LinkBoard] [分页] click 事件触发');
            console.log('[LinkBoard] [分页] e.target:', e.target);
            // 忽略 Tab 切换按钮的点击，避免干扰
            if (e.target.closest('[data-bs-toggle="tab"]')) {
                console.log('[LinkBoard] [分页] e.target 是 Tab 切换按钮，忽略此次点击');
                return;
            }
            var btn = e.target.closest('.lb-pagination button');
            console.log('[LinkBoard] [分页] btn (最近的的分页按钮):', btn);
            if (!btn || btn.disabled) {
                console.log('[LinkBoard] [分页] btn 不存在或已禁用，中止');
                return;
            }

            var pane = btn.closest('.tab-pane');
            console.log('[LinkBoard] [分页] pane (最近的tab-pane):', pane);
            var categoryId = pane.dataset.categoryId;
            console.log('[LinkBoard] [分页] categoryId:', categoryId);
            var currentPage = parseInt(pane.dataset.currentPage);
            console.log('[LinkBoard] [分页] currentPage:', currentPage);
            var totalPages = parseInt(pane.dataset.totalPages);
            console.log('[LinkBoard] [分页] totalPages:', totalPages);
            var newPage = currentPage;

            if (btn.classList.contains('lb-page-first')) newPage = 1;
            else if (btn.classList.contains('lb-page-prev')) newPage = Math.max(1, currentPage - 1);
            else if (btn.classList.contains('lb-page-next')) newPage = Math.min(totalPages, currentPage + 1);
            else if (btn.classList.contains('lb-page-last')) newPage = totalPages;

            console.log('[LinkBoard] [分页] newPage:', newPage, '(原 currentPage:', currentPage + ')');
            if (newPage !== currentPage) {
                console.log('[LinkBoard] [分页] 调用 loadPage');
                loadPage(pane, categoryId, newPage, pageSize);
            } else {
                console.log('[LinkBoard] [分页] newPage === currentPage，不调用 loadPage');
            }
        });

        // Listen for tab switching events (native click, works with Bootstrap 5 native events)
        var tabNav = document.getElementById('linkBoardTabs');
        console.log('[LinkBoard] [Tab] tabNav (nav 元素):', tabNav);
        if (tabNav) {
            console.log('[LinkBoard] [Tab] 开始注册 Tab 按钮原生 click 监听器');
            tabNav.addEventListener('click', function (e) {
                var tabBtn = e.target.closest('button[data-bs-toggle="tab"]');
                if (!tabBtn) {
                    console.log('[LinkBoard] [Tab] click 目标不是 Tab 按钮，忽略');
                    return;
                }
                console.log('[LinkBoard] [Tab] Tab 按钮被点击:', tabBtn);
                console.log('[LinkBoard] [Tab] tabBtn.dataset:', tabBtn.dataset);

                // 从被点击按钮的 data-bs-target 拿到 pane ID（格式如 "lb-pane-xxx"，无 #）
                var paneId = tabBtn.dataset.bsTarget;
                console.log('[LinkBoard] [Tab] paneId (来自 button data-bs-target):', paneId);

                // 拼接成 CSS 选择器（需要加 #）
                var targetPane = paneId ? document.querySelector('#' + paneId) : null;
                console.log('[LinkBoard] [Tab] targetPane:', targetPane);

                if (!targetPane) {
                    console.log('[LinkBoard] [Tab] targetPane 未找到，中止');
                    return;
                }

                // Bootstrap 切换是异步的，等 DOM 更新完成再加载数据
                var tryLoad = function () {
                    var $activePane = $('#' + paneId);
                    console.log('[LinkBoard] [Tab] $activePane (jQuery):', $activePane);
                    if ($activePane.length === 0) {
                        console.log('[LinkBoard] [Tab] $activePane 未找到，重试');
                        setTimeout(tryLoad, 50);
                        return;
                    }
                    var categoryId = $activePane.data('categoryId');
                    console.log('[LinkBoard] [Tab] categoryId:', categoryId);
                    var currentPage = parseInt($activePane.data('currentPage')) || 1;
                    console.log('[LinkBoard] [Tab] currentPage:', currentPage);
                    console.log('[LinkBoard] [Tab] 调用 loadPage');
                    loadPage(targetPane, categoryId, currentPage, pageSize);

                    // 手动切换 Bootstrap active class（ABP 环境中 Bootstrap 事件可能不完整）
                    tabNav.querySelectorAll('.nav-link').forEach(function (btn) {
                        btn.classList.remove('active');
                        btn.removeAttribute('aria-selected');
                        btn.setAttribute('aria-selected', 'false');
                    });
                    tabBtn.classList.add('active');
                    tabBtn.setAttribute('aria-selected', 'true');

                    var tabContent = document.getElementById('linkBoardTabContent');
                    if (tabContent) {
                        tabContent.querySelectorAll('.tab-pane').forEach(function (p) {
                            p.classList.remove('show', 'active');
                        });
                        targetPane.classList.add('show', 'active');
                    }
                };
                setTimeout(tryLoad, 50);
            });
        } else {
            console.log('[LinkBoard] [Tab] tabNav 未找到，Tab切换监听未注册');
        }

        function loadPage(pane, categoryId, page, size) {
            console.log('[LinkBoard] [loadPage] 调用开始');
            console.log('[LinkBoard] [loadPage] pane:', pane);
            console.log('[LinkBoard] [loadPage] categoryId:', categoryId);
            console.log('[LinkBoard] [loadPage] page:', page, ', size:', size);

            var skipCount = (page - 1) * size;
            var url = '/api/app/link/public-board?categoryId=' + categoryId + '&skipCount=' + skipCount + '&maxResultCount=' + size;
            console.log('[LinkBoard] [loadPage] 请求 URL:', url);

            var container = pane.querySelector('.lb-links-container');
            console.log('[LinkBoard] [loadPage] container:', container);
            if (!container) {
                console.log('[LinkBoard] [loadPage] container 未找到，中止');
                return;
            }
            container.style.opacity = '0.5';

            console.log('[LinkBoard] [loadPage] 发起 fetch 请求...');
            fetch(url, { credentials: 'include' })
                .then(function (res) {
                    console.log('[LinkBoard] [loadPage] fetch 收到响应，status:', res.status);
                    return res.json();
                })
                .then(function (data) {
                    console.log('[LinkBoard] [loadPage] 解析 JSON 成功，data:', data);
                    var items = data.items || [];
                    console.log('[LinkBoard] [loadPage] items 数量:', items.length);
                    var html = '';
                    items.forEach(function (link, index) {
                        console.log('[LinkBoard] [loadPage] 链接实例[' + index + ']:', link);
                        var icon = link.icon
                            ? '<i class="' + escapeHtml(link.icon) + ' me-3 text-primary"></i>'
                            : '<i class="fas fa-external-link-alt me-3 text-primary"></i>';
                        var desc = link.description
                            ? '<small class="text-muted text-truncate d-block">' + escapeHtml(link.description) + '</small>'
                            : '';
                        html += '<a href="' + escapeHtml(link.url) + '" target="_blank" class="list-group-item list-group-item-action link-item">'
                            + '<div class="d-flex align-items-center">'
                            + icon
                            + '<div class="text-truncate">'
                            + '<div class="fw-semibold text-truncate">' + escapeHtml(link.title) + '</div>'
                            + desc
                            + '</div></div></a>';
                    });
                    console.log('[LinkBoard] [loadPage] 构建的 HTML:', html);
                    console.log('[LinkBoard] [loadPage] 更新 container.innerHTML');
                    container.innerHTML = html;
                    console.log('[LinkBoard] [loadPage] 设置后 container.innerHTML:', container.innerHTML);
                    console.log('[LinkBoard] [loadPage] 设置后 container.children.length:', container.children.length);
                    container.style.opacity = '1';

                    var totalPages = parseInt(pane.dataset.totalPages);
                    pane.dataset.currentPage = page;

                    var pageSpan = pane.querySelector('.lb-current-page');
                    if (pageSpan) pageSpan.textContent = page;

                    var firstBtn = pane.querySelector('.lb-page-first');
                    var prevBtn = pane.querySelector('.lb-page-prev');
                    var nextBtn = pane.querySelector('.lb-page-next');
                    var lastBtn = pane.querySelector('.lb-page-last');

                    if (firstBtn) firstBtn.disabled = (page <= 1);
                    if (prevBtn) prevBtn.disabled = (page <= 1);
                    if (nextBtn) nextBtn.disabled = (page >= totalPages);
                    if (lastBtn) lastBtn.disabled = (page >= totalPages);
                    console.log('[LinkBoard] [loadPage] 完成');
                })
                .catch(function (err) {
                    console.error('[LinkBoard] [loadPage] fetch 错误:', err);
                    container.style.opacity = '1';
                });
        }

        function escapeHtml(str) {
            if (!str) return '';
            var div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }
    });
</script>
