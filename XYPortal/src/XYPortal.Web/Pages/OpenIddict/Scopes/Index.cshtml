@page
@using XYPortal.Permissions
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.Localization
@using XYPortal.Localization
@model XYPortal.Web.Pages.OpenIddict.Scopes.IndexModel
@inject IAuthorizationService AuthorizationService
@inject IHtmlLocalizer<XYPortalResource> L
@section styles {
    <abp-style src="/Pages/OpenIddict/Scopes/index.css" />
}
@section scripts {
    <abp-script src="/Pages/OpenIddict/Scopes/index.js" />
}

<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-md-6">
                <h5 class="card-title">@L["Menu:OpenIddictScopes"]</h5>
            </div>
            <div class="col-md-6 text-end">
                @if ((await AuthorizationService.AuthorizeAsync(User, XYPortalPermissions.OpenIdDictScopeCreate)).Succeeded)
                {
                    <button id="NewOpenIddictScopeButton" class="btn btn-primary">
                        <i class="fa fa-plus"></i> @L["NewScope"]
                    </button>
                }
            </div>
        </div>
    </div>
    <div class="card-body">
        <table id="OpenIddictScopesTable" class="table table-striped"></table>
    </div>
</div>
