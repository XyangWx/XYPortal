@page
@model XYPortal.Web.Pages.IndexModel
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Security.Claims
@using Microsoft.AspNetCore.Http
@using XYPortal.Localization
@using XYPortal.Web.Components.LinkBoardWidget
@using Volo.Abp.Users
@using XYPortal.RandomStringProvider.Web
@using XYPortal.RandomStringProvider.Web.Components.RandomStringProvider
@inject IHtmlLocalizer<XYPortalResource> L
@inject ICurrentUser CurrentUser
@inject IHttpContextAccessor HttpContextAccessor

@section styles {
    <abp-style src="/Pages/Index.css" />
}

@section scripts {
    <abp-script src="/Pages/Index.js" />
}

<div class="row mb-3 align-items-start">
    @* 第一列：欢迎语 *@
    <div class="col-xl-4 col-12">
        <div class="card w-100">
            <div class="card-body">
                <h5 class="mb-0">
                    @if (CurrentUser.IsAuthenticated)
                    {
                        var surname = HttpContextAccessor.HttpContext?.User.FindFirst("surname")?.Value ?? "";
                        var name = HttpContextAccessor.HttpContext?.User.FindFirst("name")?.Value ?? "";
                        <span>欢迎！@surname@name</span>
                    }
                    else
                    {
                        <span>欢迎！</span>
                    }
                </h5>
            </div>
        </div>
    </div>

    @* 第二列：LinkBoard Widget *@
    <div class="col-xl-4 col-12">
        @await Component.InvokeAsync(typeof(LinkBoardWidgetViewComponent))
    </div>

    @* 第三列：RandomString Widget *@
    <div class="col-xl-4 col-12">
        @await Component.InvokeAsync(typeof(RandomStringWidgetViewComponent), new { length = 16 })
    </div>
</div>

@* 第二行：空白行，以后添加组件 *@
<div class="row">
    <div class="col-12">
        @* 预留区域，后续组件可在此添加 *@
    </div>
</div>
