@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@using XYPortal.Localization
@model XYPortal.Web.Pages.LinkBoard.Links.CreateModalModel
@inject IHtmlLocalizer<XYPortalResource> L
@{
    Layout = null;
}

<form method="post" asp-page="/LinkBoard/Links/CreateModal">
    <abp-modal>
        <abp-modal-header title="@L["LinkBoard:NewLink"].Value"></abp-modal-header>
        <abp-modal-body>
            <div class="mb-3">
                <label asp-for="Input.CategoryId" class="form-label">@L["LinkBoard:Category"]</label>
                <select asp-for="Input.CategoryId" asp-items="Model.Categories" class="form-select" onchange="refreshSortOrder()"></select>
                <span asp-validation-for="Input.CategoryId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Title" class="form-label">@L["LinkBoard:LinkTitle"]</label>
                <input asp-for="Input.Title" class="form-control" />
                <span asp-validation-for="Input.Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Url" class="form-label">@L["LinkBoard:LinkUrl"]</label>
                <input asp-for="Input.Url" class="form-control" type="url" />
                <span asp-validation-for="Input.Url" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Description" class="form-label">@L["LinkBoard:LinkDescription"]</label>
                <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Icon" class="form-label">@L["LinkBoard:LinkIcon"]</label>
                <input asp-for="Input.Icon" class="form-control" placeholder="fas fa-link" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.SortOrder" class="form-label">@L["LinkBoard:SortOrder"]</label>
                <input asp-for="Input.SortOrder" type="number" class="form-control" />
            </div>
            <div class="mb-3 form-check">
                <input asp-for="Input.IsPublic" class="form-check-input" type="checkbox" />
                <label asp-for="Input.IsPublic" class="form-check-label">@L["LinkBoard:IsPublic"]</label>
            </div>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>

@section scripts {
    <script>
        async function refreshSortOrder() {
            var categoryId = document.getElementById('Input_CategoryId').value;
            var sortOrderInput = document.getElementById('Input_SortOrder');
            
            if (!categoryId) {
                sortOrderInput.value = '';
                return;
            }
            
            try {
                var response = await fetch('/api/app/link/max-index?categoryId=' + categoryId);
                var result = await response.json();
                sortOrderInput.value = result.index;
            } catch (e) {
                console.error('Failed to get max index:', e);
            }
        }
    </script>
}
